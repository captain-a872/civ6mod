		<Row Tag="LOC_MAP_RR_CONTINENTS_NAME" Language="en_US">
			<Text>Real Geography: Continents (Dev)</Text>
		</Row>
		<Row Tag="LOC_MAP_RR_CONTINENTS_NAME" Language="zh_Hans_CN">
			<Text>地大物博：大陆（开发中）</Text>
