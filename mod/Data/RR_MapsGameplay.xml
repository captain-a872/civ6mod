<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================================
     RRMap 游戏内数据：向"游戏数据库"（Gameplay）的 Maps 表注册自定义尺寸行。

     引擎建网格时读取的就是这张表的 GridWidth/GridHeight（原版六个尺寸行全部
     定义于此，见游戏内置 Base/Assets/Gameplay/Data/Maps.xml；配置库 MapSizes 表
     只管前端下拉框，不含网格宽高）。地图脚本运行期还从这里读
     NumNaturalWonders / Continents / PlateValue（RR_Continents.lua 的
     GameInfo.Maps[Map.GetMapSize()] 查询，T4 已加 nil 兜底）。

     列值对齐原版 MAPSIZE_STANDARD（84x54, 5 奇观, 4 板块, 4 大湖）按 4 倍面积缩放：
       GridWidth/GridHeight : 168x108（1:4 比例尺下标准档 = 原版标准 x2）
       NumNaturalWonders    : 8  （面积 4 倍，约 1.6 倍密度）
       PlateValue           : 5  （对齐原版 LARGE/HUGE 的板块数）
       Continents           : 8  （AddLakes 大湖数，面积 4 倍）
       DefaultPlayers       : 1  （M5 性能减负：默认只有自己；原版语义"该尺寸
                              建议玩家数"，前端创建界面 AI 数默认值从这儿来）
       Types 行照原版六个尺寸均在 Gameplay Types 表注册 KIND_MAPSIZE 的先例补上，
       防引擎按 Types 枚举尺寸时漏掉自定义档。

     M3 性能档（六测用户反馈：168x108=18144 格，比原版巨大 10240 格多 77%，
     回合性能压力大）：MAPSIZE_RR_STD10 = 120x78（9360 格，≈原版巨大面积，
     比例尺观感不变、每格承载的内容密度不变，只缩地图幅面）。
       NumNaturalWonders/Continents 等比收到 6/6，PlateValue 收 4。
     ============================================================================ -->
<GameInfo>
	<Types>
		<Row Type="MAPSIZE_RR_STD14" Kind="KIND_MAPSIZE"/>
		<Row Type="MAPSIZE_RR_STD10" Kind="KIND_MAPSIZE"/>
	</Types>
	<Maps>
		<!-- 理由（M5）：DefaultPlayers 与配置库 RR_Config.xml 同步降为 1（默认 solo，
		     建图/回合计时不再被 8 个 AI 拖累）；网格与自然奇观/板块/大湖参数不动。 -->
		<Row MapSizeType="MAPSIZE_RR_STD14" Name="LOC_MAPSIZE_RR_STD14_NAME" Description="LOC_MAPSIZE_RR_STD14_DESCRIPTION" DefaultPlayers="1" GridWidth="168" GridHeight="108" NumNaturalWonders="8" PlateValue="5" Continents="8"/>
		<Row MapSizeType="MAPSIZE_RR_STD10" Name="LOC_MAPSIZE_RR_STD10_NAME" Description="LOC_MAPSIZE_RR_STD10_DESCRIPTION" DefaultPlayers="1" GridWidth="120" GridHeight="78" NumNaturalWonders="6" PlateValue="4" Continents="6"/>
	</Maps>
</GameInfo>
