<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================================
     RRMap 前端配置：向"配置数据库"（Configuration）注册自定义地图脚本与自定义尺寸。

     游戏"创建游戏 → 地图类型"下拉列表的数据来源就是 Maps 表；
     "地图尺寸"下拉列表的数据来源是 MapSizes 表（Domain 列区分归属哪张地图）。
     本写法对照真实生产数据（游戏内置 Base/Assets/Configuration/Data/EarthMaps.xml，
     即地球静态地图的 per-map 尺寸列表范式，效果与 YnAMP 自定义尺寸一致）：
       <Maps>            —— 地图脚本注册（File 用裸文件名，与 ImportFiles 导入同名）
       <MapSizes>        —— 自定义尺寸行，Domain="RR_Continents.lua" 表示只对本图生效
       <MapDomainOverrides> —— 把本图的"地图尺寸"下拉框切换到 RR_Continents.lua 域
                              （注释原文：This is a REPLACEMENT not a Union）
     说明：
       File      —— 脚本文件名（裸文件名，不含目录；须与 ImportFiles 导入的文件同名，
                     且不能与游戏原文件或其他 Mod 重名，故用 RR_ 前缀）
       Name      —— 地图类型显示名（LOC 标签，翻译见 Text/RR_Text.xml）
       Description - 地图类型描述（LOC 标签）
       SortIndex —— 在地图类型列表中的排序位置，取 40 避开原版脚本的序号
       MapSizes 行 SortIndex 40/50 避开原版 10~60（原版最大=MAPSIZE_HUGE 60）
     ============================================================================ -->
<GameInfo>
	<Maps>
		<Row File="RR_Continents.lua" Name="LOC_MAP_RR_CONTINENTS_NAME" Description="LOC_MAP_RR_CONTINENTS_DESCRIPTION" SortIndex="40"/>
		<!-- M9 东亚真实地图：独立脚本 RR_EastAsia.lua（东亚—西太平洋 70°E~145°E、
		     10°N~55°N 真实地理，生成器 ground truth 教材）。SortIndex 41 紧随其后。 -->
		<Row File="RR_EastAsia.lua" Name="LOC_MAP_RR_EASTASIA_NAME" Description="LOC_MAP_RR_EASTASIA_DESCRIPTION" SortIndex="41"/>
	</Maps>

	<!-- T4 自定义 1:4 尺寸（配置库侧）：1:4 比例尺下"标准"档位 = 标准图 2 倍网格。
	     MAPSIZE_RR_STD14 = 168x108（18144 格）。MaxPlayers/MaxCityStates 沿用原版
	     MAPSIZE_HUGE 的上限（20/24），低于 62 硬上限。
	     M5 性能减负（用户实测 120x78 回合压力仍大，明确许可先去 AI/城邦）：
	     DefaultPlayers 8→1（进创建界面默认只有自己，AI 数默认 0）；
	     MinPlayers 2→1（滑杆可拖到底，想 solo 不必加 AI 再删）；
	     DefaultCityStates 12→0（城邦默认清零）。上限列不动，需要时手动加回。 -->
	<MapSizes>
		<Row Domain="RR_Continents.lua" MapSizeType="MAPSIZE_RR_STD14" Name="LOC_MAPSIZE_RR_STD14_NAME" Description="LOC_MAPSIZE_RR_STD14_DESCRIPTION" MinPlayers="1" MaxPlayers="20" DefaultPlayers="1" MinCityStates="0" MaxCityStates="24" DefaultCityStates="0" SortIndex="40"/>
		<!-- M3 性能档（5dc9771 只补了游戏库 Maps 行，漏了配置库这行，导致前端尺寸
		     下拉框只有 168x108）：120x78 网格比 STD14 小，SortIndex 排在其后（50）。
		     玩家/城邦上下限与 Default 值与 STD14 同批调整为 M5 减负值（理由见上）。 -->
		<Row Domain="RR_Continents.lua" MapSizeType="MAPSIZE_RR_STD10" Name="LOC_MAPSIZE_RR_STD10_NAME" Description="LOC_MAPSIZE_RR_STD10_DESCRIPTION" MinPlayers="1" MaxPlayers="20" DefaultPlayers="1" MinCityStates="0" MaxCityStates="24" DefaultCityStates="0" SortIndex="50"/>
		<!-- M9 东亚真实地图用同一性能档尺寸（120x78 = 数据格网 1:1，脚本内
		     采样恒等不插值）。MapSizes 行按 (Domain, MapSizeType) 为键，
		     复用 MAPSIZE_RR_STD10 须在本图 Domain 下重开行；游戏库 Maps 行
		     （网格宽高来源）是全局键，RR_MapsGameplay.xml 已注册，不重开。 -->
		<Row Domain="RR_EastAsia.lua" MapSizeType="MAPSIZE_RR_STD10" Name="LOC_MAPSIZE_RR_STD10_NAME" Description="LOC_MAPSIZE_RR_STD10_DESCRIPTION" MinPlayers="1" MaxPlayers="20" DefaultPlayers="1" MinCityStates="0" MaxCityStates="24" DefaultCityStates="0" SortIndex="50"/>
	</MapSizes>

	<!-- T4 本图尺寸选择器切换：照 EarthMaps.xml 生产范式（ParameterId="MapSize"）。
	     效果是选 RR_Continents.lua 时，尺寸下拉只出现上面的 1:4 自定义档位。 -->
	<MapDomainOverrides>
			<Row Map="RR_Continents.lua" ParameterId="MapSize" Domain="RR_Continents.lua"/>
		<!-- M9：东亚图尺寸选择器切到本图 Domain（同表行键独立，互不影响）。 -->
		<Row Map="RR_EastAsia.lua" ParameterId="MapSize" Domain="RR_EastAsia.lua"/>
	</MapDomainOverrides>

	<!-- M7 开局全图探索开关：照原版 MapSettings.xml 的地图脚本参数范式
	     （temperature/雨量同一张 Parameters 表），向配置库插一行。
	     列含义（对照原版生产行逐列核实）：
	       Key1="Map" Key2="RR_Continents.lua" —— 参数绑定到本地图脚本
	         （Key2 须与 <Maps> 行的 File 同名，前端只在选中本图时显示该参数）；
	       ParameterId —— 参数在 Parameters 表内的唯一行键（RR_ 前缀防撞名）；
	       Domain="bool" —— 内置布尔值域（原版 SetupParameters.xml 先例：
	         Domain="bool" 渲染为勾选框，无需 DomainValues 行）；
	       DefaultValue="0" —— 默认关闭；
	       ConfigurationGroup="Map" ConfigurationId="RR_RevealAll" —— 存进
	         地图配置的键名，gameplay 侧按此键读取；
	       GroupId="MapOptions" —— 显示在"创建游戏 → 高级设置"的地图选项组；
	       Hash="0" —— 与原版行保持一致；
	       SortIndex="290" —— 原版本图参数占 230~260，取 290 排到其后。
	     说明：原版行无 ValueDomain 列（值域由 Domain 列表达），故不臆造该列。 -->
	<Parameters>
		<Row Key1="Map" Key2="RR_Continents.lua" ParameterId="RRRevealAll" Name="LOC_MAP_RR_REVEAL_ALL_NAME" Description="LOC_MAP_RR_REVEAL_ALL_DESCRIPTION" Domain="bool" DefaultValue="0" ConfigurationGroup="Map" ConfigurationId="RR_RevealAll" GroupId="MapOptions" Hash="0" SortIndex="290"/>
		<!-- M9：东亚图绑定同一"开局全图探索"开关。原版先例（MapSettings.xml
		     Temperature 行）：同 ParameterId 按 Key2 分地图多行并存；两图
		     共用 ConfigurationId="RR_RevealAll"，RR_Debug.lua 读键不变。 -->
		<Row Key1="Map" Key2="RR_EastAsia.lua" ParameterId="RRRevealAll" Name="LOC_MAP_RR_REVEAL_ALL_NAME" Description="LOC_MAP_RR_REVEAL_ALL_DESCRIPTION" Domain="bool" DefaultValue="0" ConfigurationGroup="Map" ConfigurationId="RR_RevealAll" GroupId="MapOptions" Hash="0" SortIndex="290"/>
	</Parameters>
</GameInfo>
